# PostgreSQL connection for production. Leave unset only for liveness-only local work.
DATABASE_URL=postgresql+asyncpg://noolu:change-me@postgres:5432/noolu

# Public web origin used when constructing share links.
PUBLIC_BASE_URL=https://idiyappam.midhunpm.in

# Mounted persistent storage, never a container-layer path in production.
UPLOAD_DIR=/data/uploads

# MVP safety and privacy defaults.
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_DIMENSION=4096
RETENTION_DAYS=7
PROCESSING_TIMEOUT_SECONDS=30
